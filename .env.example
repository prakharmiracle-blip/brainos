# ============================================================
# BrainOS — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# LLM PROVIDER → openrouter (default) | openai | together | anthropic
LLM_PROVIDER=openrouter

# ── OpenRouter (RECOMMENDED) ─────────────────────────────────
# Get a free key: https://openrouter.ai/keys
# Browse models:  https://openrouter.ai/models
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# FREE models (zero credits needed):
#   mistralai/mistral-7b-instruct:free
#   meta-llama/llama-3.1-8b-instruct:free
#   google/gemma-2-9b-it:free
#   microsoft/phi-3-mini-128k-instruct:free
#
# PAID models (great quality, tiny cost):
#   anthropic/claude-3-haiku       ~$0.00025/1K tokens
#   openai/gpt-4o-mini             ~$0.00015/1K tokens
#   google/gemini-flash-1.5        ~$0.000075/1K tokens
#   meta-llama/llama-3.1-70b-instruct:free  (sometimes free)
LLM_MODEL=mistralai/mistral-7b-instruct:free

OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_SITE_NAME=BrainOS

# ── Other providers (uncomment to use instead) ───────────────
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here

# LLM_PROVIDER=together
# TOGETHER_API_KEY=your-key-here

# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Embeddings (100% local, no key needed) ───────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Storage ──────────────────────────────────────────────────
FAISS_INDEX_PATH=data/faiss_index
UPLOAD_DIR=data/uploads

# ── API Server ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-in-production

# ── Voice (Whisper runs locally) ─────────────────────────────
# tiny=39MB | base=74MB | small=244MB | medium=769MB
WHISPER_MODEL=base

# ── RAG ──────────────────────────────────────────────────────
TOP_K_RETRIEVAL=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
